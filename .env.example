# Copy to .env and fill in ONE provider. .env is git-ignored — never commit keys.
# Downloading and building the dataset need no key; only `tsl extract` and prediction do.

# anthropic or openai
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model override, e.g. claude-sonnet-5-5 or gpt-4o-mini
LLM_MODEL=
